      "parameters": {
        "jsCode": "// 1. Descargamos todas las filas que trajo el nodo de Google Sheets\nconst filasSheets = $input.all();\n\n// 2. Rescatamos el JSON original enviado por Python desde el nodo Webhook raíz\nconst eansRecibidos = $('Webhook').first().json.body.eans || [];\n\nconst resultado = {};\n\n// 3. Cruzamos los datos eficientemente usando la sintaxis nativa de JS ('of')\nfor (const ean of eansRecibidos) {\n    const eanStr = String(ean).trim();\n    \n    // Buscamos la coincidencia exacta en el maestro de tu Hoja 1\n    const coincidencia = filasSheets.find(fila => String(fila.json.ean).trim() === eanStr);\n    \n    if (coincidencia) {\n        resultado[eanStr] = {\n            \"producto\": coincidencia.json.producto || \"Producto sin nombre\",\n            \"marca\": coincidencia.json.marca || \"Genérico\",\n            \"precio_min_proc\": coincidencia.json.precio_min_proc || 0\n        };\n    } else {\n        resultado[eanStr] = {\n            \"producto\": `Producto Nuevo (${eanStr})`,\n            \"marca\": \"Genérico\",\n            \"precio_min_proc\": 0\n        };\n    }\n}\n\nreturn { json: resultado };"
      },
